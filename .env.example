# Copy to .env and fill in. Never commit .env, and never point it at the
# production database or Blob store: the seed, the tests and photo uploads
# write to whatever these name.

# --- Required ---------------------------------------------------------------

# PostgreSQL for development (e.g. a free Neon project). The pooled URL is
# used by the app, the direct one by Prisma's CLI (migrations need it).
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# --- Optional: each feature works without its keys, as noted ---------------

# Google sign-in (Google Cloud OAuth client). Without them, the "Continue
# with Google" button fails; email and password sign-in still works.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Natural-language search (Anthropic API key). Without it, search falls
# back to plain keyword matching.
LLM_API_KEY=""

# Stripe test-mode keys. Set both or neither: without them, checkout says
# payments are unavailable (free listings still book). The webhook secret is
# only needed if Stripe can reach this server (e.g. `stripe listen`); without
# it, the browser completes payments on its own.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET=""

# Listing photos: a PUBLIC Vercel Blob store of your own. BLOB_STORE_HOST
# must be set alongside the token: it defaults to the live site's store.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_HOST="your-store-id.public.blob.vercel-storage.com"

# One-click demo logins on the login page. Never set an admin account here
# (they're refused anyway).
DEMO_LOGIN_ENABLED="false"
DEMO_OWNER_EMAIL="emma.owner@example.com"
DEMO_USER_EMAIL="demo-user@example.com"

# Password for the seeded sample accounts. Used only by `prisma db seed`;
# leave unset and they get no password.
SEED_USER_PASSWORD=""

# Only for a local production build (`pnpm build && pnpm start`): Auth.js
# trusts the host automatically on Vercel and under `pnpm dev`.
# AUTH_TRUST_HOST=true
