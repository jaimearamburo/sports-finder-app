// Prisma schema for the sports booking app. Docs:
// https://pris.ly/d/prisma-schema

// Model and field names are camelCase for application code; @map/@@map give the
// Postgres tables and columns snake_case names.

generator client {
  // Prisma 7: the "prisma-client" generator needs an explicit output path.
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (CLI) and in the
  // @prisma/adapter-pg adapter (app runtime), not here.
}

// =============================================================================
// ENUMS
// =============================================================================

// A user's platform-wide role.
// - admin: full access to every venue, listing and booking.
// - venue_owner: manages only venues they own (Venue.ownerId), and can browse
//   and book like any user.
// - user: browses, books and manages their own bookings.
enum UserRole {
  admin
  venue_owner
  user

  @@map("user_role")
}

// Decides a Listing's booking screen and conflict-check logic. A closed set: a
// new value needs new UI and booking logic.
// - time_range: pick a start time and length within opening hours (courts,
//   pitches).
// - date_range: pick days (campsites, day passes).
// - fixed_session: book one scheduled occurrence with limited capacity
//   (classes).
enum BookingMechanic {
  time_range
  date_range
  fixed_session

  @@map("booking_mechanic")
}

// - pending: card authorized, not yet captured.
// - confirmed: paid (or free).
// - cancelled: frees the capacity again (excluded from capacity checks).
enum BookingStatus {
  pending
  confirmed
  cancelled

  @@map("booking_status")
}

// =============================================================================
// CORE DOMAIN MODELS
// =============================================================================

// Every account, whatever its role. A venue owner owns any number of venues
// from one account.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  // Null for users who signed up with Google.
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(user)
  // Required by @auth/prisma-adapter, which writes them on Google sign-in.
  // Credentials users never have emailVerified set (no verification flow).
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  venues       Venue[]
  bookings     Booking[]
  bookingHolds BookingHold[]

  accounts Account[]
  sessions Session[]

  @@map("users")
}

// A physical venue, owned by one User.
model Venue {
  id          String  @id @default(cuid())
  ownerId     String  @map("owner_id")
  cityId      String  @map("city_id")
  name        String
  description String?
  address     String

  // Rolling public booking window, in days from today on the venue's clock.
  bookingWindowDays Int @default(30) @map("booking_window_days")

  // Default minutes a BookingHold reserves a slot; a Listing can override it.
  holdDurationMinutes Int @default(5) @map("hold_duration_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Restrict, not Cascade: deleting a user or city must not wipe venues,
  // listings and booking history.
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  city                  City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  listings              Listing[]
  availabilityOverrides AvailabilityOverride[]

  @@index([ownerId])
  @@index([cityId])
  @@map("venues")
}

// Platform-curated reference list (seed-managed, like City, Tag and Activity),
// so cities can't name a country inconsistently.
model Country {
  id   String @id @default(cuid())
  name String @unique
  // ISO 3166-1 alpha-2 code (e.g. "AU"); groups the browse city dropdown.
  code String @unique

  createdAt DateTime @default(now()) @map("created_at")

  cities City[]

  @@map("countries")
}

model City {
  id   String @id @default(cuid())
  name String @unique

  // Optional state or territory, for display and to allow same-named cities in
  // different regions.
  region String?

  // IANA timezone (e.g. "Australia/Sydney"); every venue time in this city uses
  // it.
  timezone String

  // Restrict: a country with cities can't be deleted.
  countryId String  @map("country_id")
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  venues Venue[]

  @@map("cities")
}

// A platform-wide category of bookable thing ("Tennis", "Camping", "Pilates
// Class"), shared by every venue's listings. Its bookingMechanic decides how
// every Listing under it is booked.
model Activity {
  id              String          @id @default(cuid())
  name            String          @unique
  bookingMechanic BookingMechanic @map("booking_mechanic")
  description     String?
  icon            String?

  // Only used with date_range. true: accommodation (check-in/check-out,
  // "nights", one contiguous range), e.g. camping. false: a pass (individually
  // picked days, "days"), e.g. a gym day pass. Set per Activity so every
  // Listing under it behaves the same.
  isAccommodation Boolean @default(false) @map("is_accommodation")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listings Listing[]
  tags     ActivityTag[]

  @@map("activities")
}

// A browse quick-filter tag. Many-to-many with Activity: "Tennis Class" is
// tagged both "Tennis" and "Classes".
model Tag {
  id           String   @id @default(cuid())
  name         String   @unique
  // Browse chip display fields; formats aren't enforced by the database. Equal
  // displayOrder values fall back to alphabetical order.
  emoji        String   @default("🏷️")
  color        String   @default("#1f1f1f") // hex string, e.g. "#2f9e52"
  displayOrder Int      @default(1) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  activities ActivityTag[]

  @@map("tags")
}

// Activity <-> Tag join table.
model ActivityTag {
  activityId String @map("activity_id")
  tagId      String @map("tag_id")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([activityId, tagId])
  @@map("activity_tags")
}

// The bookable thing at a venue ("Court 1", "Campsite A", "Monday 6pm HIIT").
// Its Activity's bookingMechanic decides which field group below applies.
// There's no slot table: availability is computed from bookings (see Booking).
model Listing {
  id                        String  @id @default(cuid())
  venueId                   String  @map("venue_id")
  activityId                String  @map("activity_id")
  name                      String
  description               String?
  // Public Vercel Blob URL of the listing's photo; null shows the tag emoji.
  // The browser uploads the file to Blob directly.
  imageUrl                  String? @map("image_url")
  // Maximum overlapping quantity: 1 for an exclusive court or campsite, more
  // for a class, null for unlimited (skips the capacity check).
  capacity                  Int?    @default(1)
  // Per-booking cap on quantity (e.g. at most 5 places of a 20-place class in
  // one order). Null: no cap beyond capacity.
  maxBookingsPerTransaction Int?    @default(5) @map("max_bookings_per_transaction")
  pricePerUnit              Decimal @map("price_per_unit") @db.Decimal(10, 2)

  // time_range: start time and length within these bounds.
  operatingHoursStart String? @map("operating_hours_start") // e.g. "09:00"
  operatingHoursEnd   String? @map("operating_hours_end") // e.g. "21:00"
  minDurationMinutes  Int?    @map("min_duration_minutes")
  maxDurationMinutes  Int?    @map("max_duration_minutes")
  incrementMinutes    Int?    @map("increment_minutes")

  // date_range: number of days or nights.
  minDurationDays Int? @map("min_duration_days")
  maxDurationDays Int? @map("max_duration_days")

  // fixed_session: one weekly occurrence per Listing. A class held on several
  // weekdays is several Listings.
  recurrenceDayOfWeek    Int?    @map("recurrence_day_of_week") // 0 = Sunday ... 6 = Saturday
  recurrenceStartTime    String? @map("recurrence_start_time") // e.g. "18:00"
  sessionDurationMinutes Int?    @map("session_duration_minutes")

  // Overrides Venue.holdDurationMinutes; null inherits it.
  holdDurationMinutes Int? @map("hold_duration_minutes")

  // Null: active. Set: archived (hidden from browse and new bookings) since
  // that time. Archiving is the only way to retire a listing with booking
  // history (Booking.listing is Restrict).
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  venue                 Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  activity              Activity               @relation(fields: [activityId], references: [id], onDelete: Restrict)
  bookings              Booking[]
  availabilityOverrides AvailabilityOverride[]
  holds                 BookingHold[]

  @@index([venueId])
  @@index([activityId])
  @@map("listings")
}

// One reservation of a Listing for [startsAt, endsAt), the same shape for every
// booking mechanic.
//
// Conflicts are prevented in application code, not by a constraint (capacity
// can exceed 1): inside a transaction, sum the quantity of non-cancelled
// bookings and active holds overlapping the requested range, and reject if
// adding the new quantity would exceed listing.capacity. The (listingId,
// startsAt, endsAt) index keeps that query fast.
//
// userId is null for guest bookings, which use the guest fields instead (guest
// checkout isn't built).
model Booking {
  id        String  @id @default(cuid())
  // Shared by every row from one checkout (a pass creates one row per day);
  // carried over from BookingHold.orderId.
  orderId   String  @map("order_id")
  listingId String  @map("listing_id")
  userId    String? @map("user_id")

  // Only used when userId is null (guest checkout).
  guestName  String? @map("guest_name")
  guestEmail String? @map("guest_email")
  guestPhone String? @map("guest_phone")

  // Who the booking is for, collected at checkout; may differ from the account
  // holder. Phone is optional.
  attendeeName  String  @map("attendee_name")
  attendeeEmail String  @map("attendee_email")
  attendeePhone String? @map("attendee_phone")

  startsAt DateTime      @map("starts_at")
  endsAt   DateTime      @map("ends_at")
  status   BookingStatus @default(pending)

  // How many capacity units this booking claims (a group booking several places
  // at once).
  quantity Int @default(1)

  // The Stripe PaymentIntent for this booking, shared by every row in the
  // order. A pending booking's card is authorized but not yet captured (see
  // completeOrderPayment). Null for free bookings.
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  amountPaid            Decimal? @map("amount_paid") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Restrict: a listing with bookings can't be deleted; archive it instead
  // (Listing.archivedAt).
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  // SetNull: deleting an account keeps its bookings for the venue's records.
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId, startsAt, endsAt])
  @@index([userId])
  @@index([orderId])
  // The payment webhook looks bookings up by PaymentIntent.
  @@index([stripePaymentIntentId])
  @@map("bookings")
}

// - block: unavailable (a closure).
// - open: available despite a venue-level block, or beyond the booking window.
enum OverrideKind {
  block
  open

  @@map("override_kind")
}

// A closure or exception for a venue or one listing: one-off or weekly
// closures, a venue-wide block, or a listing-level exception that overrides a
// venue block or opens dates beyond the booking window.
//
// Exactly one of venueId/listingId is set (application-enforced). A
// listing-level row beats a venue-level row on the same date.
model AvailabilityOverride {
  id        String       @id @default(cuid())
  venueId   String?      @map("venue_id")
  listingId String?      @map("listing_id")
  kind      OverrideKind

  // Weekdays (0 = Sunday ... 6 = Saturday) for a weekly rule within
  // startDate-endDate; empty for every day in the range.
  daysOfWeek Int[] @map("days_of_week")

  // Without endDate the override covers startDate only, whatever daysOfWeek
  // says.
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // Venue-local "HH:MM" bounds; null on both means the whole day.
  startTime String? @map("start_time")
  endTime   String? @map("end_time")

  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  venue   Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([venueId, startDate, endDate])
  @@index([listingId, startDate, endDate])
  @@map("availability_overrides")
}

// A temporary claim on a slot while a user checks out, so two people can't book
// the same slot at once. Kept apart from Booking: holds are short-lived and
// high-churn; bookings are permanent records.
//
// Expiry is enforced by filtering on expiresAt > now in every capacity query,
// so expired rows never need deleting for correctness.
model BookingHold {
  id        String   @id @default(cuid())
  // Shared by every hold from one checkout (a pass creates one row per day) and
  // generated in application code, since a column default would differ per row.
  // The only id the URL and UI expose; carried over to the Booking rows.
  orderId   String   @map("order_id")
  listingId String   @map("listing_id")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")

  // Null for a guest hold (guest checkout isn't built).
  userId     String? @map("user_id")
  guestToken String? @map("guest_token")

  // How many capacity units this hold reserves (mirrors Booking.quantity).
  quantity Int @default(1)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId, startsAt, endsAt])
  @@index([expiresAt])
  @@index([orderId])
  // For the one-active-hold-per-user check. Race safety comes from
  // createBookingHold's User row lock, not this index.
  @@index([userId, expiresAt])
  @@map("booking_holds")
}

// Auth.js models required by @auth/prisma-adapter; the adapter reads and writes
// them.
// - Account: one row per OAuth provider linked to a user.
// - Session: database sessions (unused: the app uses JWT sessions).
// - VerificationToken: email verification / magic links (unused).

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
